# network.config — Evil Webcam BFT Demo
#
# ╔══════════════════════════════════════════════════════════════╗
# ║  Startup order (4 terminals, all from backend/):             ║
# ║                                                              ║
# ║  Terminal 1 — L3 aggregator (auto-runs this config):         ║
# ║    node layer3_base.js --config network.config               ║
# ║                                                              ║
# ║  Terminal 2 — Honest Node A:                                 ║
# ║    node layer2_webcam.js A 5000                              ║
# ║                                                              ║
# ║  Terminal 3 — Evil Node B (approx. same time or after A):   ║
# ║    L2_BOOTSTRAP=http://localhost:5000 \                      ║
# ║      node layer2_evil_webcam.js B 5001                       ║
# ║                                                              ║
# ║  Terminal 4 — Webcam device (dual-homed to A + B):           ║
# ║    python3 layer1_webcam.py                                  ║
# ║                                                              ║
# ║  What happens:                                               ║
# ║    Webcam sends the same signed frame to BOTH A and B        ║
# ║    Node A correctly reports MOTION                           ║
# ║    Node B reports NO_MOTION (lie) and gossips it to A        ║
# ║    Node A: peer claim conflicts with own analysis → FRAUD    ║
# ║    Node A shuns B and submits evidence to Solana             ║
# ║    Dashboard marks B as COMPROMISED                          ║
# ║                                                              ║
# ║  Inspect results:                                            ║
# ║    curl http://localhost:5000/fraud-log                      ║
# ║    node layer3_sender.js submit-fraud-log http://localhost:5000
# ╚══════════════════════════════════════════════════════════════╝

# ── Nodes — MUST come before driver lines so all peers are known ──────────────
register node A 5000
register node B 5001

# ── Drivers — pushed to ALL nodes in the session peer list ───────────────────
register driver WEBCAM_LIGHT
register driver MOBILE_ORIENTATION

# ── Devices — map physical device IDs to driver types on each node ────────────
register device-file layer1_webcam.py A
register device-file layer1_webcam.py B

# register device-file layer1_mobile_gyro.py A