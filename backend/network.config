# network.config — run with: node layer3_sender.js run-config network.config
#
# ╔══════════════════════════════════════════════════════════════╗
# ║  Byzantine Fault Tolerance (BFT) Demo                        ║
# ║                                                              ║
# ║  Startup order:                                              ║
# ║    Terminal 1 — Honest Node A:                               ║
# ║      node layer2_webcam.js A 5000                            ║
# ║                                                              ║
# ║    Terminal 2 — Evil Node B:                                 ║
# ║      L2_BOOTSTRAP=http://localhost:5000 \                    ║
# ║        node layer2_evil_zero.js B 5001                       ║
# ║                                                              ║
# ║    Terminal 3 — Layer 3 config:                              ║
# ║      node layer3_sender.js run-config network.config         ║
# ║                                                              ║
# ║    Terminal 4 — Layer 1 Mobile (sends to Evil Node B):       ║
# ║      L2_BOOTSTRAP=http://localhost:5001 python layer1_mobile_gyro.py
# ║                                                              ║
# ║  What happens:                                               ║
# ║    L1 signs value=85 with HMAC-SHA256, sends to Node B        ║
# ║    Node B tampers value→0, gossips to Node A                 ║
# ║    Node A: Verify(pubKey, "MOBILE_01|0.00|ts", sig) → FAIL   ║
# ║    Node A shuns B and submits fraud evidence to Solana        ║
# ║    HMAC-SHA256 mismatch confirms: FRAUD PROVEN ON CHAIN       ║
# ║                                                              ║
# ║  Inspect results:                                            ║
# ║    curl http://localhost:5000/fraud-log                      ║
# ║    node layer3_sender.js submit-fraud-log http://localhost:5000
# ╚══════════════════════════════════════════════════════════════╝

# ── Honest Node A (port 5000) — The Accuser / Judge ───────────────────────────
register node A 5000

# ── Evil Node B (port 5001) — The Liar ────────────────────────────────────────
# Start with: L2_BOOTSTRAP=http://localhost:5000 node layer2_evil_zero.js B 5001
register node B 5001

# ── Drivers ───────────────────────────────────────────────────────────────────
register driver WEBCAM_LIGHT
register driver MOBILE_ORIENTATION

# ── Register MOBILE_01 on Node B so the payload gets the correct driver type ───
register device-file layer1_mobile_gyro.py B
register device-file layer1_webcam.py A
